# Server-only settings. Existing data is required; missing DB causes startup failure.
KBPD_DATA_DIR=/srv/kinebalance/data
KBPD_BIND_HOST=127.0.0.1
PORT=4511
# Replace with the exact reviewed preview origin. No wildcard, no trailing slash.
KBPD_ALLOWED_ORIGINS=https://REPLACE_WITH_REVIEWED_PREVIEW.vercel.app
KBPD_SOURCE_COMMIT=REPLACE_WITH_REVIEWED_COMMIT
# Optional path to the original evidence registry; ARCI sources remain unchanged.
# KBPD_EVIDENCE_FILE=/srv/kinebalance/evidence/evidence-registry.json
