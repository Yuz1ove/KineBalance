    "allowImportingTsExtensions": true,
    "noEmit": true,
    "target": "ES2022",
    "strict": true,
    "types": [
      "node"
    ],
    "composite": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
